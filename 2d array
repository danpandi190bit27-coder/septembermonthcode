import java.io.*;
import java.math.*;
import java.security.*;
import java.text.*;
import java.util.*;
import java.util.concurrent.*;
import java.util.regex.*;

public class Solution {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        int[][] arr = new int[6][6];

        // Read the 6x6 2D array
        for (int i = 0; i < 6; i++) {
            String[] arrRowItems = scanner.nextLine().split(" ");
            for (int j = 0; j < 6; j++) {
                int arrItem = Integer.parseInt(arrRowItems[j]);
                arr[i][j] = arrItem;
            }
        }
        scanner.close();

        // Initialize maxSum to the lowest possible value for an hourglass
        // 7 elements * -9 (minimum possible constraint) = -63
        int maxSum = Integer.MIN_VALUE;

        // Loop through the array bounds that can form a valid hourglass
        for (int i = 0; i < 4; i++) {
            for (int j = 0; j < 4; j++) {
                // Calculate the sum of the current hourglass
                int currentSum = arr[i][j]   + arr[i][j+1]   + arr[i][j+2] // Top row
                                             + arr[i+1][j+1]               // Middle element
                               + arr[i+2][j] + arr[i+2][j+1] + arr[i+2][j+2]; // Bottom row
                
                // Track the maximum sum found
                if (currentSum > maxSum) {
                    maxSum = currentSum;
                }
            }
        }

        // Print the largest sum
        System.out.println(maxSum);
    }
}
